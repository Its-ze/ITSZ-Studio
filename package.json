{
  "name": "itsz-studio",
  "version": "0.1.0",
  "description": "ITSZ's Studio photo viewer and editor.",
  "main": "desktop/main.js",
  "author": "ITSZ",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "make:icons": "node scripts/generate-icons.mjs",
    "validate": "node --check app.js && node --check desktop/main.js && node --check desktop/preload.js && node --check scripts/generate-icons.mjs && node --check scripts/prepare-pages.mjs",
    "dist": "npm run make:icons && electron-builder",
    "dist:win": "npm run make:icons && electron-builder --win nsis portable",
    "dist:linux": "npm run make:icons && electron-builder --linux AppImage deb rpm"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "studio.itsz.desktop",
    "productName": "ITSZ's Studio",
    "executableName": "ITSZ-Studio",
    "artifactName": "ITSZ-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://its-ze.github.io/ITSZ-Studio/downloads/"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "ITSZ-Studio-Setup-${version}-${os}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ITSZ's Studio"
    },
    "portable": {
      "artifactName": "ITSZ-Studio-Portable-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Graphics",
      "synopsis": "Photo viewer and editor",
      "description": "ITSZ's Studio photo viewer and editor.",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
